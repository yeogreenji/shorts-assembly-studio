{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --include=dev",
  "outputDirectory": "dist",
  "functions": {
    "api/generate.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/image.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}

{
  "name": "shortcut-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "숏컷 스튜디오 — 3초 훅부터 자막·BGM·MP4까지, 쇼츠 한 편을 한 화면에서 조립하는 스튜디오",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "render-server": "node server/render-server.mjs",
    "render": "python3 scripts/render_shorts.py"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}

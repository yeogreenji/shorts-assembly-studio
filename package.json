{
  "name": "shortcut-studio",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "description": "주제 한 줄로 웹툰·로판 일러스트 6컷이 살아 움직이는 쇼츠를 만들고, 영상(.webm)으로 저장하는 스튜디오",
  "scripts": {
    "dev": "vite",
